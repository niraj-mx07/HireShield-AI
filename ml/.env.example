# =============================================================================
# HireShield-AI ML — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# Only needed if using the Kaggle API for automated data download.
# =============================================================================

# --- Kaggle API credentials ---
# Get these from https://www.kaggle.com/settings → "Create New Token"
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
