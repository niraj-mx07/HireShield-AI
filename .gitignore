# macOS System Files
.DS_Store

# Frontend
node_modules/
frontend/node_modules/
frontend/dist/

# Python / Virtualenv
__pycache__/
*.pyc
venv/
.venv/
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
ml/.env
ml/.env.*
!ml/.env.example
.pytest_cache/

# ML — raw data and model artifacts (keep code + small metrics files)
ml/data/raw/
ml/data/processed/
ml/artifacts/*.joblib
ml/artifacts/*.pkl
ml/artifacts/*.bin

# Notebook checkpoints
ml/notebooks/.ipynb_checkpoints/

# Size/orientation-normalised copies of the certificate dataset.  Derived from
# ml/data/raw (already ignored) and rebuilt by ml/training/train_certificate_cnn.py,
# so committing them would add ~11MB of regenerable images to every clone.
ml/notebooks/certificates_normalised/

# Editor / agent tool state
.freebuff/

# Vision weights: keep only the exported production model (see below)
ml/artifacts/*.onnx
ml/artifacts/*.pt
ml/artifacts/*.pth

# Explicitly track lightweight production models for cloud deployment (<3MB total)
!ml/artifacts/best_model.joblib
!ml/artifacts/tfidf_vectorizer.joblib
!ml/artifacts/certificate_cnn.onnx
!ml/artifacts/certificate_cnn.json
# Local vision-training venv (torch is training-only, never shipped)
.ml-venv/
