# HireShield-AI Frontend Environment Variables
# Copy this file to .env and fill in your values.

# Backend API URL (defaults to https://hireshield-api-x1yt.onrender.com in production)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Google OAuth 2.0 Web Client ID
# Generated from Google Cloud Console -> Google Auth Platform -> Clients
VITE_GOOGLE_CLIENT_ID=
