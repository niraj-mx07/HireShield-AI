# =============================================================================
# HireShield-AI Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your local environment.
# Do NOT commit .env to version control.
# =============================================================================

# --- Database (MongoDB) ---
DATABASE_URL=mongodb://localhost:27017
DATABASE_NAME=hireshield

# --- Application ---
SECRET_KEY=change-me-to-a-random-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Verification Provider Keys (optional, stubbed for now) ---
# GOOGLE_SAFE_BROWSING_API_KEY=
# WHOIS_API_KEY=
# LINKEDIN_API_KEY=

# --- Logging ---
LOG_LEVEL=INFO

# --- External Page Retrieval (app/services/web_retrieval.py) ---
# Retrieval only runs when the user sets consent_for_external_lookups=true.
WEB_RETRIEVAL_ENABLED=true
WEB_RETRIEVAL_TIMEOUT=6.0
WEB_RETRIEVAL_MAX_BYTES=524288

# --- Named-Entity Recognition (app/services/nlp_entities.py) ---
# Regex identifiers always run; contextual NER needs spacy / transformers.
NLP_NER_ENABLED=true
TRANSFORMERS_NER_ENABLED=true
SPACY_MODEL=en_core_web_sm
TRANSFORMERS_NER_MODEL=dslim/bert-base-NER
